//Dude from a very popular and respected demo on the demoscene:
//Let there be light by Bero Farbraush, Revision 2018, PC 64k
var p=window.roboticPen3D;
//head
var vm3Dhead=p.createSphere(0,0,0,1,1,1,1,16,32);
vm3Dhead.vec4color=vec4.create([0.9,0.9,0.9,1]);
//p.deselectAllVertices();

//torso
p.createCylinder(0,0,4,1,6,1.5,1,1,32);
p.deselectAllVertices();

//hand
var vm3Dhand=p.createCylinder(0,0,1.5,1,6,0.5,0.5,0.5,32);
p.selectAllVertices();
p.rotateYselectedVerticesAroundMedian(90);
p.deselectAllVertices();
for(var ii=0;ii<33;ii++)
	vm3Dhand.arrSelection[ii]=0.5;
vm3Dhand.refreshSelection();
p.extrudeFullySelectedFaces(true);                                 
p.translateSelectedVertices([-1.5,1.5,1.5]);
p.extrudeFullySelectedFaces(true);                                 
p.translateSelectedVertices([-1.5,1.5,1.5]);
p.rotateZselectedVerticesAroundMedian(-45);
p.selectAllVertices();
p.duplicateFullySelectedFaces(true);
p.scaleSelectedVertices([-1,1,1]);
p.deselectAllVertices();

//pants
var vm3Dpants=p.createCylinder(0,0,7,1,2,1.55,1.05,1.05,32);
vm3Dpants.vec4color=vec4.create([0.1,0.1,0.1,1]);
p.deselectAllVertices();

//legs
var vm3Dleg=p.createCylinder(1,0,11,0.5,6,1,1.5,1,32);
vm3Dleg.vec4color=vec4.create([0.1,0.1,0.1,1]);
p.deselectAllVertices();
for(var ii=0;ii<33;ii++)
	vm3Dleg.arrSelection[ii]=0.5;
vm3Dleg.refreshSelection();
p.refresh();
p.selectAllVertices();
p.duplicateFullySelectedFaces(true);
p.scaleSelectedVertices([-1,1,1]);
p.deselectAllVertices();

//feet
p.createSphere(1,0.5,14,0.5,1,3,1,16,32);
p.deselectAllVertices();
p.createSphere(-1,0.5,14,0.5,1,3,1,16,32);
p.deselectAllVertices();

//palms
var vm3Dpalm0=p.createSphere(4.5,3,4.5,0.5,1,1,1,16,32);
vm3Dpalm0.vec4color=vec4.create([0.9,0.9,0.9,1]);
p.deselectAllVertices();
var vm3Dpalm1=p.createSphere(-4.5,3,4.5,0.5,1,1,1,16,32);
vm3Dpalm1.vec4color=vec4.create([0.9,0.9,0.9,1]);
p.deselectAllVertices();
p.refresh();

